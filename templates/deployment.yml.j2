apiVersion: apps/v1

kind: Deployment

metadata:
  name: java-app
  namespace: {{ namespace }}

spec:

  replicas: 2

  selector:
    matchLabels:
      app: java-app

  template:

    metadata:

      labels:
        app: java-app

    spec:

      containers:

      - name: java-app

        image: {{ image_name }}:{{ image_tag }}

        imagePullPolicy: Never

        ports:

        - containerPort: {{ container_port }}

        readinessProbe:
          httpGet:
            path: /
            port: {{ container_port }}
          initialDelaySeconds: 20
          periodSeconds: 10

        livenessProbe:
          httpGet:
            path: /
            port: {{ container_port }}
          initialDelaySeconds: 30
          periodSeconds: 15